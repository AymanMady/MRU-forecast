# =============================================================================
# MRU-Forecast — environment variables
# Copy to `.env` and fill in real values.  `.env` is git-ignored: never commit it.
#     cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Exchange-rate data providers
# -----------------------------------------------------------------------------
# NOTE: the provider actually used is chosen in Phase 2, after verifying which
# ones publish an MRU series with sufficient history and daily frequency.
# Leave unused keys empty — the ingestion layer skips providers without a key.

# https://openexchangerates.org  (free tier: USD base only, historical endpoint)
OPENEXCHANGERATES_APP_ID=

# https://exchangerate.host  (apilayer)
EXCHANGERATE_HOST_API_KEY=

# https://www.alphavantage.co  (FX daily series)
ALPHAVANTAGE_API_KEY=

# -----------------------------------------------------------------------------
# External macro / commodity factors (optional regressors)
# -----------------------------------------------------------------------------
# https://fred.stlouisfed.org/docs/api/api_key.html  (oil, gold, US rates)
FRED_API_KEY=

# -----------------------------------------------------------------------------
# Application configuration
# -----------------------------------------------------------------------------
MRU_ENV=dev                       # dev | prod
MRU_CONFIG_PATH=configs/config.yaml
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MLflow tracking
# -----------------------------------------------------------------------------
# MLflow's file backend is in maintenance mode and raises on recent versions;
# SQLite is the recommended local backend.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=mru-forecast

# -----------------------------------------------------------------------------
# PostgreSQL (optional; only used by the `postgres` docker-compose profile)
# -----------------------------------------------------------------------------
POSTGRES_USER=mru
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mru_forecast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API / dashboard
#
# API_HOST / API_PORT are used when you run the API directly (`make api`).
# Under Docker they select only the HOST port that gets published; the port
# inside the container is fixed (8000 / 8501), so changing these is safe.
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
